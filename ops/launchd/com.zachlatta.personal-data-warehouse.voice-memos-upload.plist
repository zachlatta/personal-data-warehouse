<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.zachlatta.personal-data-warehouse.voice-memos-upload</string>

    <key>ProgramArguments</key>
    <array>
      <string>/Users/zrl/.local/share/personal-data-warehouse/bin/voice-memos-upload-launchd</string>
    </array>

    <key>StartInterval</key>
    <integer>300</integer>

    <!-- Fire on change too: the store's WAL is written when a memo arrives
         from iCloud and again when its audio finishes downloading, and the
         directory changes when the file appears, so a memo is uploaded seconds
         after it lands on this Mac instead of at the next five-minute tick.
         The run waits out a few seconds of settle itself, so the throttle is
         10 s; StartInterval stays as the floor. -->
    <key>WatchPaths</key>
    <array>
      <string>/Users/zrl/Library/Group Containers/group.com.apple.VoiceMemos.shared/Recordings/CloudRecordings.db-wal</string>
      <string>/Users/zrl/Library/Group Containers/group.com.apple.VoiceMemos.shared/Recordings</string>
    </array>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/zrl/Library/Logs/personal-data-warehouse/voice-memos-upload.launchd.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/zrl/Library/Logs/personal-data-warehouse/voice-memos-upload.launchd.err.log</string>
  </dict>
</plist>
