<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.zachlatta.personal-data-warehouse.agent-sessions-upload</string>

    <key>ProgramArguments</key>
    <array>
      <string>/Users/zrl/.local/share/personal-data-warehouse/bin/agent-sessions-upload-launchd</string>
    </array>

    <!-- Resident: the wrapper watches the transcripts for a five-minute
         window (a pass every two seconds), posts the heartbeat and exits;
         KeepAlive starts the next window. ThrottleInterval spaces relaunches
         after a window that failed fast. -->
    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/zrl/Library/Logs/personal-data-warehouse/agent-sessions-upload.launchd.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/zrl/Library/Logs/personal-data-warehouse/agent-sessions-upload.launchd.err.log</string>
  </dict>
</plist>
