# pdw ingest scanner as a service on a Linux machine on the scanner's LAN
# (on mew since 2026-11-01). It must stay up: the scanner's panel lists the
# PDW names under Scan > to PC only while this registers them, and each
# press is sent here.
#
# Install (as root), with the binary at /home/zrl/.local/share/pdw-scanner/pdw
# and its settings in /home/zrl/.config/pdw-scanner/env (mode 600):
#   PDW_API_URL=...  PDW_SECRET_TOKEN=...  SCANNER_HOST=<scanner address>
#   SCANNER_ACCOUNT=<account>  SCANNER_DEVICE=<this machine's name>
#   install -m 644 pdw-scanner.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now pdw-scanner
[Unit]
Description=PDW scanner: scan into the warehouse from the scanner's panel
After=network-online.target
Wants=network-online.target

[Service]
User=zrl
WorkingDirectory=/home/zrl/.local/share/pdw-scanner
EnvironmentFile=/home/zrl/.config/pdw-scanner/env
ExecStart=/home/zrl/.local/share/pdw-scanner/pdw ingest scanner --spool-dir /home/zrl/.local/share/pdw-scanner/spool --lock-file /home/zrl/.local/share/pdw-scanner/scanner.lock
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
