[Unit]
Description=Run the agent-sessions uploader every 5 minutes

[Timer]
# Mirrors the macOS LaunchAgent cadence (StartInterval=300, RunAtLoad).
# OnActiveSec, not OnBootSec, and no Persistent=true: a user manager restarted
# after an OOM has no service run for OnUnitActiveSec to count from, and
# Persistent's stamp makes systemd drop an OnBootSec already in the past. The
# timer then sits "active (elapsed)" with no next run, and uploads stop.
OnActiveSec=2min
OnUnitActiveSec=300s
Unit=personal-data-warehouse-agent-sessions-upload.service

[Install]
WantedBy=timers.target
