[Unit]
Description=Upload local AI agent session transcripts (openclaw/Claude Code/Codex) as they are written
After=network-online.target
Wants=network-online.target

[Service]
# Resident: the wrapper runs `pdw ingest agent-sessions --watch 300s` (a pass
# every two seconds), posts the window's heartbeat, and exits; Restart=always
# starts the next window. No timer: on 2026-11-06 a restarted user manager left
# the old five-minute timer "active (elapsed)" and nothing ran for 13 hours.
Type=simple
# Self-locating wrapper: derives its root from its own path. As checked in, it
# runs from a checkout (mew-dev, openclaw); bin/sync-linux-device-runtime
# rewrites both paths to ~/.local/share/personal-data-warehouse for a host
# with no checkout (mew).
WorkingDirectory=%h/dev/zachlatta/personal-data-warehouse
ExecStart=%h/dev/zachlatta/personal-data-warehouse/bin/agent-sessions-upload-systemd
Restart=always
# A failed window (app unreachable, box offline) retries after this pause.
RestartSec=5
Nice=10

[Install]
WantedBy=default.target
