{
  "description": "Shared credential-masking corpus for app/internal/server/credential_redaction_property_test.go and tests/test_credential_redaction.py. Every secret is fake and is assembled from parts at test time, so no token-shaped string is stored here. <<name>> expands to the joined secret; <<mask:kind:name>> expands to [REDACTED:kind:<first 6 hex of sha256(secret)>].",
  "secrets": {
    "dbpw": ["FakeDb", "Pass9x7Q2rK"],
    "redispw": ["fake", "Redis0Pass42"],
    "httpspw": ["FAKEhttps", "0pass77"],
    "slack": ["xo", "xb-", "100000000001-200000000002-FAKEfakeFAKEfake0000"],
    "slackuser": ["xo", "xp-", "1-2-3-FAKEtoken0000fake"],
    "ghp": ["gh", "p_", "FAKE0000fake1111FAKE2222fake3333FAKE"],
    "gho": ["gh", "o_", "fake0000FAKE1111fake2222FAKE3333fake"],
    "ghpat": ["github", "_pat_", "11FAKE000_fakefakefakefake0000FAKE"],
    "openai": ["s", "k-", "proj-FAKE0000fake1111FAKE2222"],
    "anthropic": ["s", "k-", "ant-api03-FAKE0000fake1111FAKE2222fake"],
    "awsid": ["AK", "IAFAKE00000000FAKE"],
    "awssecret": ["fakeFAKE0000fakeFAKE", "0000fakeFAKE0000fake"],
    "pemhead": ["-----BEGIN RSA PRIV", "ATE KEY-----"],
    "pemfoot": ["-----END RSA PRIV", "ATE KEY-----"],
    "pembody": ["\nMIIFAKEfakeFAKEfake0000FAKEfake1111FAKEfake2222FAKEfake3333FAKEfake\n", "4444FAKEfake5555FAKEfake6666FAKEfake7777FAKEfake8888FAKEfake9999==\n"],
    "pemtail": ["\nMIIFAKEfakeFAKEfake0000FAKEfake1111FAKEfake2222FAKEfake3333FAKEfake", "4444FAKEfake5555"],
    "pdw": ["FAKE", "fake0000FAKEfake0000FAKEfake0000FAKE"],
    "jwt": ["eyJFAKE0", ".eyJfake1.FAKEsig000"],
    "pgpw": ["FakePg", "Pass2026x"],
    "s3": ["0fa4e0fa4e0fa4e0fa4e0fa4e0fa4e0f", "a4e0fa4e0fa4e0fa4e0fa4e0fa4e0fa4"],
    "clientsecret": ["GOCSPX-FAKE", "0000fake1111"],
    "querykey": ["FAKEquery", "Key0042abc"],
    "jsonpw": ["Fake!Json", "Pass#2026"]
  },
  "cases": [
    {"name": "postgres url", "input": "psql postgresql://app_user:<<dbpw>>@db.internal.test:5432/warehouse -c 'select 1'", "expected": "psql postgresql://app_user:<<mask:url_password:dbpw>>@db.internal.test:5432/warehouse -c 'select 1'"},
    {"name": "postgres scheme", "input": "DATABASE_URL=postgres://writer:<<dbpw>>@10.0.0.9/pdw", "expected": "DATABASE_URL=postgres://writer:<<mask:url_password:dbpw>>@10.0.0.9/pdw"},
    {"name": "mysql url", "input": "mysql://root:<<dbpw>>@localhost:3306/app", "expected": "mysql://root:<<mask:url_password:dbpw>>@localhost:3306/app"},
    {"name": "redis url", "input": "connect redis://default:<<redispw>>@cache.test:6379/0 now", "expected": "connect redis://default:<<mask:url_password:redispw>>@cache.test:6379/0 now"},
    {"name": "amqp url", "input": "AMQP_URL=amqp://guest:<<redispw>>@mq.test:5672/vhost", "expected": "AMQP_URL=amqp://guest:<<mask:url_password:redispw>>@mq.test:5672/vhost"},
    {"name": "https url", "input": "git remote add origin https://bot:<<httpspw>>@git.test/org/repo.git", "expected": "git remote add origin https://bot:<<mask:url_password:httpspw>>@git.test/org/repo.git"},
    {"name": "slack bot token", "input": "SLACK_BOT_TOKEN=<<slack>>", "expected": "SLACK_BOT_TOKEN=<<mask:slack_token:slack>>"},
    {"name": "slack user token", "input": "auth.test with <<slackuser>> returned ok", "expected": "auth.test with <<mask:slack_token:slackuser>> returned ok"},
    {"name": "github classic token", "input": "export GH_TOKEN=<<ghp>>", "expected": "export GH_TOKEN=<<mask:github_token:ghp>>"},
    {"name": "github oauth token", "input": "oauth: <<gho>> (scopes repo)", "expected": "oauth: <<mask:github_token:gho>> (scopes repo)"},
    {"name": "github fine-grained token", "input": "token is <<ghpat>>", "expected": "token is <<mask:github_token:ghpat>>"},
    {"name": "openai key", "input": "OPENAI_API_KEY=<<openai>>", "expected": "OPENAI_API_KEY=<<mask:openai_key:openai>>"},
    {"name": "anthropic key", "input": "curl -H 'x-api-key: <<anthropic>>' https://api.anthropic.test", "expected": "curl -H 'x-api-key: <<mask:anthropic_key:anthropic>>' https://api.anthropic.test"},
    {"name": "aws key pair", "input": "aws configure set aws_access_key_id <<awsid>>\naws configure set aws_secret_access_key <<awssecret>>", "expected": "aws configure set aws_access_key_id <<awsid>>\naws configure set aws_secret_access_key <<mask:aws_secret_key:awssecret>>"},
    {"name": "aws key pair in prose", "input": "keys <<awsid>> / <<awssecret>> for the bucket", "expected": "keys <<awsid>> / <<mask:aws_secret_key:awssecret>> for the bucket"},
    {"name": "aws key pair in escaped text", "input": "log: {\\\"id\\\": \\\"<<awsid>>\\\", \\\"key\\\": \\\"<<awssecret>>\\\"} (truncated", "expected": "log: {\\\"id\\\": \\\"<<awsid>>\\\", \\\"key\\\": \\\"<<mask:aws_secret_key:awssecret>>\\\"} (truncated"},
    {"name": "pem private key", "input": "cat id_rsa\n<<pemhead>><<pembody>><<pemfoot>>\ndone", "expected": "cat id_rsa\n<<pemhead>><<mask:private_key:pembody>><<pemfoot>>\ndone"},
    {"name": "truncated pem private key", "input": "<<pemhead>><<pemtail>>", "expected": "<<pemhead>><<mask:private_key:pemtail>>"},
    {"name": "pdw access token", "input": "pdw login --token pdw_aaaaaaaaaaaaaaaa_<<pdw>>", "expected": "pdw login --token pdw_aaaaaaaaaaaaaaaa_<<mask:pdw_token:pdw>>"},
    {"name": "bearer header", "input": "-H \"Authorization: Bearer <<jwt>>\"", "expected": "-H \"Authorization: Bearer <<mask:bearer_token:jwt>>\""},
    {"name": "labelled password env", "input": "PGPASSWORD=<<pgpw>> psql -h db.test", "expected": "PGPASSWORD=<<mask:password:pgpw>> psql -h db.test"},
    {"name": "labelled s3 secret key", "input": "S3 secret key: <<s3>>\naccess key: GKfake", "expected": "S3 secret key: <<mask:secret:s3>>\naccess key: GKfake"},
    {"name": "labelled client secret", "input": "client_secret = \"<<clientsecret>>\"", "expected": "client_secret = \"<<mask:secret:clientsecret>>\""},
    {"name": "api key query parameter", "input": "GET https://api.weather.test/v1?api_key=<<querykey>>&q=nyc", "expected": "GET https://api.weather.test/v1?api_key=<<mask:secret:querykey>>&q=nyc"},
    {"name": "json password field", "input": "{\"user\": \"svc\", \"password\": \"<<jsonpw>>\", \"port\": 5432}", "expected": "{\"user\": \"svc\", \"password\": \"<<mask:password:jsonpw>>\", \"port\": 5432}"},
    {"name": "json client secret field", "input": "{\"client_id\":\"abc\",\"client_secret\":\"<<clientsecret>>\"}", "expected": "{\"client_id\":\"abc\",\"client_secret\":\"<<mask:secret:clientsecret>>\"}"},
    {"name": "same secret twice", "input": "first <<slack>> then <<slack>>", "expected": "first <<mask:slack_token:slack>> then <<mask:slack_token:slack>>"},
    {"name": "words ending in sk stay", "input": "desk-0123456789abcdefghijklmnop task-0123456789abcdefghijkl risk-0123456789abcdefghijklmnop"},
    {"name": "openssh security-key algorithm names stay", "input": "PubkeyAcceptedAlgorithms sk-ssh-ed25519-cert-v01@openssh.com,sk-ecdsa-sha2-nistp256-cert-v01@openssh.com"},
    {"name": "sk-learn stays", "input": "pip install sk-learn scikit-learn"},
    {"name": "placeholders stay", "input": "password: <placeholder>\npassword: ${DB_PASSWORD}\npassword=$PGPASSWORD\nPASSWORD = os.environ['DB_PASSWORD']\nAPI_KEY=your-api-key-here\ntoken: <token>\nsecret: ***"},
    {"name": "weak values stay", "input": "password: hunter2\npassword: correcthorsebatterystaple\nsecret: v2\napi_key=SLACK_BOT_TOKEN_2\ntoken=get_token2()"},
    {"name": "urls without a password stay", "input": "git clone https://github.com/example/repo.git\nssh git@github.com:example/repo.git\nhttps://user@host.test/path\nhttp://localhost:8080/api"},
    {"name": "placeholder url passwords stay", "input": "postgresql://postgres:postgres@localhost:5432/pdw\npostgresql://user:password@localhost/db\npostgres://u:${PGPASS}@h/db\nredis://:****@cache:6379"},
    {"name": "regex examples stay", "input": "re.compile(r'xox[abpre]-[A-Za-z0-9-]+') and gh[pousr]_[A-Za-z0-9]{36} and sk-[A-Za-z0-9]{20,}"},
    {"name": "token counters stay", "input": "{\"input_tokens\": 1234, \"max_tokens\": 4096, \"next_page_token\": \"FAKEpageTOKEN02\", \"cache_read_input_tokens\": 0}"},
    {"name": "placeholder pem stays", "input": "<<pemhead>>\n...\n<<pemfoot>>"},
    {"name": "url-encoded run beside an access key id stays", "input": "<<awsid>> blob ab%<<awssecret>>%2Fcd"},
    {"name": "url path beside an access key id stays", "input": "<<awsid>> see https://team.slack.com/archives/C0FAKEFAKE/p100000000000000 and https://t.test/c/AbCdEfGh0123-AbCdEfGhIjKlMnOpQrSt0123456789AbCdEfGhIj-2Bxyz"},
    {"name": "url slug starting with sk- stays", "input": "https://news.test/news/sk-hynix-0123456789-memory-prices and www.example.test/sk-abcdefghij0123456789"},
    {"name": "access key id alone stays", "input": "<<awsid>> commit 0123456789abcdef0123456789abcdef01234567"},
    {"name": "masked values stay", "input": "SLACK_BOT_TOKEN=[REDACTED:slack_token:0a1b2c] and pdw_aaaaaaaaaaaaaaaa_[REDACTED] and postgres://u:[REDACTED:url_password:0a1b2c]@h/db"},
    {"name": "card numbers are not credentials", "input": "card: 4111111111111111 CVV: 987"},
    {"name": "bearer placeholder stays", "input": "Authorization: Bearer $TOKEN and Bearer <token>"}
  ],
  "property": {
    "seed": 20261123,
    "prefixes": ["", "note: ", "ran\n", "$ ", "output:\n  ", "(see) "],
    "suffixes": ["", " ok", ", then", " (exit 0)"],
    "wrappers": ["plain", "json_text", "nested_json", "escaped_json"],
    "iterations": 4,
    "corpus_sha256": "823492b1a964c18ffa4ccf26e0eb56dab2cc1f2f2271dd7502affb9638e14ef5"
  }
}
