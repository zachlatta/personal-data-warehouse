#!/system/bin/sh
# One run of the Pixel's Google Recorder uploader: the Android counterpart of
# bin/voice-memos-upload-launchd.
#
# Run as root on the rooted Pixel by the pdw-google-recorder Magisk service
# (ops/android/pdw-google-recorder/service.sh), seconds after Recorder saves a
# recording and every 5 minutes as the floor. The module carries this file,
# _pdw-upload-lib.sh and the release linux/arm64 pdw binary side by side in
# its bin/; the sysadmin repository's scripts/install-pixel-recorder-upload
# assembles and deploys it. There is no checkout on the phone.
#
# State lives in $STATE_DIR (root 0700): pdw's own config file (URL, token,
# client name) under config/pdw/, an optional .env (GOOGLE_RECORDER_DEVICE,
# GOOGLE_RECORDER_ACCOUNT), the upload ledger, and logs/. It is in
# credential-encrypted storage on purpose: the token is the warehouse's
# master secret (ingest uploads are signed with it), and the bootloader is
# unlocked, so it must not sit in /data/adb, which is readable before the PIN
# is entered. Recorder's own data is credential-encrypted too, so nothing
# here can run before the first unlock anyway.
set -u

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
STATE_DIR="${PDW_GOOGLE_RECORDER_STATE_DIR:-/data/misc_ce/0/pdw-google-recorder}"
# Magisk starts services with HOME=/ and no TMPDIR; pdw needs both writable.
export HOME="$STATE_DIR/home"
export TMPDIR="$STATE_DIR/tmp"
export XDG_CONFIG_HOME="$STATE_DIR/config"
export PDW_BIN="${PDW_BIN:-$SCRIPT_DIR/pdw}"
# The uploader's own settings (device name, fallback account) come from here.
export PDW_INGEST_PROJECT_DIR="$STATE_DIR"
. "$SCRIPT_DIR/_pdw-upload-lib.sh"
pdw_export_app_credentials
PDW="$(pdw_resolve_bin)"
LOG_DIR="$STATE_DIR/logs"
LOG_FILE="$LOG_DIR/google-recorder-upload.run.log"
HEARTBEAT_FILE="$LOG_DIR/google-recorder-upload.heartbeat"
POSTED_FILE="$LOG_DIR/google-recorder-upload.heartbeat-posted"

mkdir -p "$LOG_DIR" "$HOME" "$TMPDIR"
# The phone has no logrotate: keep the current log under 1 MiB and one old one.
if [ -f "$LOG_FILE" ] && [ "$(stat -c %s "$LOG_FILE")" -gt 1048576 ]; then
  mv -f "$LOG_FILE" "$LOG_FILE.1"
fi

started_at_epoch="$(date +%s)"
started_at_iso="$(date -Iseconds)"

echo "[$started_at_iso] starting google recorder upload" >> "$LOG_FILE"

if [ -z "$PDW" ]; then
  exit_code=1
  echo "[$(date -Iseconds)] no pdw binary found (the module ships one at $SCRIPT_DIR/pdw; set PDW_BIN)" >> "$LOG_FILE"
else
  "$PDW" ingest google-recorder --state-file "$STATE_DIR/google-recorder-upload-state.sqlite" >> "$LOG_FILE" 2>&1
  exit_code=$?
fi

finished_at_epoch="$(date +%s)"
finished_at_iso="$(date -Iseconds)"
duration_seconds="$((finished_at_epoch - started_at_epoch))"

pdw_record_run "$HEARTBEAT_FILE" "$finished_at_iso" "$exit_code"
# The service runs this on every write Recorder makes, so a long recording can
# mean a run every ten seconds. Post the verdict when it matters -- a failure,
# a run that sent something -- and otherwise at most every four minutes, which
# is still well inside the pipeline's 30-minute run interval.
last_posted="$(cat "$POSTED_FILE" 2>/dev/null || echo 0)"
sent="$(tail -n 1 "$LOG_FILE" | grep -c ' audio=[1-9]\| sidecars=[1-9]')"
if [ "$exit_code" -ne 0 ] || [ "$sent" -gt 0 ] || [ "$((finished_at_epoch - last_posted))" -ge 240 ]; then
  pdw_post_heartbeat "google_recorder" "$finished_at_iso" "$exit_code" "$duration_seconds" "$LOG_FILE"
  echo "$finished_at_epoch" > "$POSTED_FILE"
fi
echo "[$finished_at_iso] finished google recorder upload exit_code=$exit_code duration_seconds=$duration_seconds" >> "$LOG_FILE"

exit "$exit_code"
