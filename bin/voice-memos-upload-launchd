#!/bin/zsh
set -u

REPO_DIR="/Users/zrl/dev/zachlatta/personal-data-warehouse"
UV="/opt/homebrew/bin/uv"
# Run the Python uploader module DIRECTLY (not through `pdw ingest`): pdw
# self-updates on every release, and each binary replacement makes macOS
# revoke its Full Disk Access, which killed this uploader until a manual
# re-toggle. With pdw out of the exec chain, TCC only sees the stable
# binaries (zsh, uv, the venv python). Credentials still come from pdw's own
# config file, so `pdw login` remains the single setup step.
# Sourced up here, not just before the heartbeat: pdw_export_app_credentials
# has to run BEFORE the uploader so the uploader gets the URL/token too.
. "$REPO_DIR/bin/_pdw-upload-lib.sh"
pdw_export_app_credentials
LOG_DIR="$HOME/Library/Logs/personal-data-warehouse"
LOG_FILE="$LOG_DIR/voice-memos-upload.run.log"
HEARTBEAT_FILE="$LOG_DIR/voice-memos-upload.heartbeat"

mkdir -p "$LOG_DIR"

started_at_epoch="$(date +%s)"
started_at_iso="$(date -Iseconds)"

echo "[$started_at_iso] starting Voice Memos upload" >> "$LOG_FILE"

if ! cd "$REPO_DIR"; then
  exit_code=1
  echo "[$(date -Iseconds)] failed to cd to $REPO_DIR" >> "$LOG_FILE"
else
  "$UV" run python -m personal_data_warehouse_voice_memos.cli --mode incremental >> "$LOG_FILE" 2>&1
  exit_code=$?
fi

finished_at_epoch="$(date +%s)"
finished_at_iso="$(date -Iseconds)"
duration_seconds="$((finished_at_epoch - started_at_epoch))"

pdw_record_run "$HEARTBEAT_FILE" "$finished_at_iso" "$exit_code"
PDW_REPO_DIR="$REPO_DIR" PDW_UV="${UV:-uv}" pdw_post_heartbeat "apple_voice_memos" "$finished_at_iso" "$exit_code" "$duration_seconds"
echo "[$finished_at_iso] finished Voice Memos upload exit_code=$exit_code duration_seconds=$duration_seconds" >> "$LOG_FILE"

exit "$exit_code"
