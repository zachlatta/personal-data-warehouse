#!/bin/zsh
set -u

REPO_DIR="/Users/zrl/dev/zachlatta/personal-data-warehouse"
# `pdw slack publish-session` (native Go) captures the Slack desktop app's
# session -- the xoxc token from its localStorage plus the `d` cookie, decrypted
# with the "Slack Safe Storage" keychain item -- validates it against auth.test
# and publishes it to the warehouse for the change-feed sync. It runs hourly so
# the server's copy never lags the app's; the `d` cookie is good for ~13 months.
# No uv or Python in the exec chain (launchd -> zsh -> pdw). That chain used to
# keep pdw OUT on purpose, because macOS attributes the keychain grant to the
# binaries in it and pdw replaced its own binary on every release; release
# binaries are now signed with a stable identity, so the grant follows pdw
# across updates. Grant it once by running `pdw slack publish-session` from a
# GUI terminal on this Mac and choosing Always Allow.
. "$REPO_DIR/bin/_pdw-upload-lib.sh"
pdw_export_app_credentials
PDW="$(pdw_resolve_bin)"
export PDW_INGEST_PROJECT_DIR="$REPO_DIR"
LOG_DIR="$HOME/Library/Logs/personal-data-warehouse"
LOG_FILE="$LOG_DIR/slack-auth.run.log"
HEARTBEAT_FILE="$LOG_DIR/slack-auth.heartbeat"

mkdir -p "$LOG_DIR"

if [ -f "$REPO_DIR/.env" ]; then
  set -a
  source "$REPO_DIR/.env"
  set +a
fi

started_at_epoch="$(date +%s)"
started_at_iso="$(date -Iseconds)"
echo "[$started_at_iso] starting slack session publish" >> "$LOG_FILE"

if [ -z "$PDW" ]; then
  exit_code=1
  echo "[$(date -Iseconds)] no pdw binary found (install a release to ~/.local/bin/pdw or set PDW_BIN)" >> "$LOG_FILE"
elif ! cd "$REPO_DIR"; then
  exit_code=1
  echo "[$(date -Iseconds)] failed to cd to $REPO_DIR" >> "$LOG_FILE"
else
  "$PDW" slack publish-session >> "$LOG_FILE" 2>&1
  exit_code=$?
fi

finished_at_epoch="$(date +%s)"
finished_at_iso="$(date -Iseconds)"
duration_seconds="$((finished_at_epoch - started_at_epoch))"

pdw_record_run "$HEARTBEAT_FILE" "$finished_at_iso" "$exit_code"
echo "[$finished_at_iso] finished slack session publish exit_code=$exit_code duration_seconds=$duration_seconds" >> "$LOG_FILE"

exit "$exit_code"
