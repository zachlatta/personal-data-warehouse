#!/system/bin/sh
# One run of the Pixel's notification uploader: sends the PDW notification
# listener's spool to the warehouse.
#
# Run as root on the rooted Pixel by the pdw-android-notifications Magisk
# service (ops/android/pdw-android-notifications/service.sh), within seconds
# of each notification and every 5 minutes as the floor. The module carries
# this file, _pdw-upload-lib.sh and the release linux/arm64 pdw binary side by
# side in its bin/; the sysadmin repository's
# scripts/install-pixel-notification-upload assembles and deploys it, with the
# listener APK (ops/android/pdw-notification-listener). There is no checkout
# on the phone.
#
# State lives in $STATE_DIR (root 0700, credential-encrypted storage, for the
# reason bin/google-recorder-upload-android gives): pdw's own config file
# under config/pdw/, a .env (ANDROID_NOTIFICATIONS_DEVICE,
# ANDROID_NOTIFICATIONS_ACCOUNT), the run lock and logs/. The listener's
# spool is the upload ledger.
set -u

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
STATE_DIR="${PDW_ANDROID_NOTIFICATIONS_STATE_DIR:-/data/misc_ce/0/pdw-android-notifications}"
# Magisk starts services with HOME=/ and no TMPDIR; pdw needs both writable.
export HOME="$STATE_DIR/home"
export TMPDIR="$STATE_DIR/tmp"
export XDG_CONFIG_HOME="$STATE_DIR/config"
export PDW_BIN="${PDW_BIN:-$SCRIPT_DIR/pdw}"
export PDW_INGEST_PROJECT_DIR="$STATE_DIR"
. "$SCRIPT_DIR/_pdw-upload-lib.sh"
pdw_export_app_credentials
PDW="$(pdw_resolve_bin)"
LOG_DIR="$STATE_DIR/logs"
LOG_FILE="$LOG_DIR/android-notifications-upload.run.log"
HEARTBEAT_FILE="$LOG_DIR/android-notifications-upload.heartbeat"
POSTED_FILE="$LOG_DIR/android-notifications-upload.heartbeat-posted"

mkdir -p "$LOG_DIR" "$HOME" "$TMPDIR"
# The phone has no logrotate: keep the current log under 1 MiB and one old one.
if [ -f "$LOG_FILE" ] && [ "$(stat -c %s "$LOG_FILE")" -gt 1048576 ]; then
  mv -f "$LOG_FILE" "$LOG_FILE.1"
fi

started_at_epoch="$(date +%s)"
started_at_iso="$(date -Iseconds)"

echo "[$started_at_iso] starting android notifications upload" >> "$LOG_FILE"

if [ -z "$PDW" ]; then
  exit_code=1
  echo "[$(date -Iseconds)] no pdw binary found (the module ships one at $SCRIPT_DIR/pdw; set PDW_BIN)" >> "$LOG_FILE"
else
  "$PDW" ingest android-notifications --lock-file "$STATE_DIR/android-notifications-upload.lock" >> "$LOG_FILE" 2>&1
  exit_code=$?
fi

finished_at_epoch="$(date +%s)"
finished_at_iso="$(date -Iseconds)"
duration_seconds="$((finished_at_epoch - started_at_epoch))"

pdw_record_run "$HEARTBEAT_FILE" "$finished_at_iso" "$exit_code"
# Notifications can arrive every few seconds, so post the verdict when it
# matters -- a failure, a run that sent something -- and otherwise at most
# every four minutes, well inside the pipeline's 30-minute run interval.
last_posted="$(cat "$POSTED_FILE" 2>/dev/null || echo 0)"
sent="$(tail -n 1 "$LOG_FILE" | grep -c ' events=[1-9]')"
if [ "$exit_code" -ne 0 ] || [ "$sent" -gt 0 ] || [ "$((finished_at_epoch - last_posted))" -ge 240 ]; then
  pdw_post_heartbeat "android_notifications" "$finished_at_iso" "$exit_code" "$duration_seconds" "$LOG_FILE"
  echo "$finished_at_epoch" > "$POSTED_FILE"
fi
echo "[$finished_at_iso] finished android notifications upload exit_code=$exit_code duration_seconds=$duration_seconds" >> "$LOG_FILE"

exit "$exit_code"
