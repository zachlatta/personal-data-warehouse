{
  "expo": {
    "name": "PDW",
    "slug": "pdw",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pdw",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.zachlatta.pdw",
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "LHCUFF2TF5"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#121030",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.zachlatta.pdw",
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "personal-data-warehouse.zachlatta.com",
              "pathPrefix": "/timeline"
            },
            {
              "scheme": "https",
              "host": "personal-data-warehouse.zachlatta.com",
              "pathPrefix": "/mutation-review"
            },
            {
              "scheme": "https",
              "host": "personal-data-warehouse.zachlatta.com",
              "pathPrefix": "/search"
            },
            {
              "scheme": "https",
              "host": "personal-data-warehouse.zachlatta.com",
              "pathPrefix": "/notifications"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/with-left-screen",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0C0E22",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#208AEF"
        }
      ],
      "./plugins/with-messaging-notifications",
      "@bacons/apple-targets",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c5085048-1a90-4340-a13d-6624522b6589"
      },
      "pushCapabilities": [
        "android_messaging_style"
      ]
    },
    "owner": "zlatta",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/c5085048-1a90-4340-a13d-6624522b6589"
    }
  }
}
